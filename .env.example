# ==============================================================================
# Smart AI Safety Guard with Automated Testing - Environment Configuration
# ==============================================================================
# Note: The application is 100% functional offline using the built-in rule-based 
# and NLP heuristic safety guard engine without requiring any external API keys.
#
# If you wish to test live LLM responses via an external API, configure your keys here.
# NEVER commit your real .env file with actual secret keys to version control.

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Optional: Google Gemini API Key
GEMINI_API_KEY=

# Optional: Groq API Key
GROQ_API_KEY=

# Optional: Custom or Local LLM Base URL (e.g. Ollama or vLLM: http://localhost:11434/v1)
LLM_API_BASE_URL=

# Application Mode: development / production
APP_ENV=development

# Database path (default: safety_guard.db)
DATABASE_PATH=safety_guard.db
